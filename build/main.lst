 128:Core/Src/main.c **** 	turn_off_all_leds();
 129:Core/Src/main.c **** 
 130:Core/Src/main.c **** 	// Start timer at 1-second period
 131:Core/Src/main.c **** 	change_timer_period(1000);
 132:Core/Src/main.c **** 	HAL_TIM_Base_Start_IT(&htim16);
 133:Core/Src/main.c **** 	/* USER CODE END 2 */
 134:Core/Src/main.c **** 
 135:Core/Src/main.c **** 	while (1)
 136:Core/Src/main.c **** 	{
 137:Core/Src/main.c **** 		/* USER CODE BEGIN WHILE */
 138:Core/Src/main.c **** 		// Handle button press (debounced)
 139:Core/Src/main.c **** 		handle_button_press();
 140:Core/Src/main.c **** 
 141:Core/Src/main.c **** 		// Handle timer event
 142:Core/Src/main.c **** 		if (timer_event) {
 143:Core/Src/main.c **** 		  timer_event = 0;
 144:Core/Src/main.c **** 		  update_led_pattern();
 145:Core/Src/main.c **** 		}
 146:Core/Src/main.c **** 		/* USER CODE END WHILE */
 147:Core/Src/main.c **** 	}
