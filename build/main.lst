  91:Core/Src/main.c **** void handle_button_press(void)
  92:Core/Src/main.c **** {
  93:Core/Src/main.c **** 	uint32_t current_tick = HAL_GetTick();
  94:Core/Src/main.c **** 	uint8_t up_or_down = HAL_GPIO_ReadPin(GPIOA,GPIO_PIN_0); //0 = down, 1 = up
  95:Core/Src/main.c **** 
  96:Core/Src/main.c **** 	//if its up and rising edge status,
  97:Core/Src/main.c **** 	if(up_or_down == 1 && status == 1) {
  98:Core/Src/main.c **** 		speed_state ^= 1;
  99:Core/Src/main.c **** 		change_timer_period(30 + speed_state*970);
 100:Core/Src/main.c **** 		status = 2; //updated status
 101:Core/Src/main.c **** 	}
 102:Core/Src/main.c **** 	else if(up_or_down == 0 && status == 2 && current_tick - last_update > DEBOUNCE_MS) {
 103:Core/Src/main.c **** 		last_update = current_tick;
 104:Core/Src/main.c **** 		status = 0; //falling edge
 105:Core/Src/main.c **** 	}
 106:Core/Src/main.c **** 	else if(up_or_down == 1 && status == 0 && current_tick - last_update > DEBOUNCE_MS) {
 107:Core/Src/main.c **** 		last_update = current_tick;
 108:Core/Src/main.c **** 		status = 1; //rising edge
 109:Core/Src/main.c **** 	}
 110:Core/Src/main.c **** }
 111:Core/Src/main.c **** /* USER CODE END 0 */
