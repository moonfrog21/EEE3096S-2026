  52:Core/Src/main.c **** void turn_off_all_leds(void)
  53:Core/Src/main.c **** {
  54:Core/Src/main.c **** 	for(int i = 0; i<8; i++) {
  55:Core/Src/main.c **** 		HAL_GPIO_WritePin(led_ports[i],led_pins[i],GPIO_PIN_RESET);
  56:Core/Src/main.c **** 	}
  57:Core/Src/main.c **** 
  58:Core/Src/main.c **** }
  59:Core/Src/main.c **** 
  60:Core/Src/main.c **** void update_led_pattern(void)
  61:Core/Src/main.c **** {
  62:Core/Src/main.c **** 	turn_off_all_leds();
  63:Core/Src/main.c **** 	HAL_GPIO_WritePin(led_ports[current_led],led_pins[current_led],GPIO_PIN_SET);
  64:Core/Src/main.c **** 	if(current_led == 0 && direction == -1) {
  65:Core/Src/main.c **** 		direction = 1;
  66:Core/Src/main.c **** 	}
  67:Core/Src/main.c **** 	if(current_led == 7 && direction == 1) {
  68:Core/Src/main.c **** 		direction = -1;
  69:Core/Src/main.c **** 	}
  70:Core/Src/main.c **** 	current_led+=direction;
  71:Core/Src/main.c **** 
  72:Core/Src/main.c **** }
