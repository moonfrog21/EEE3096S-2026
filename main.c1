/**
  * @brief System Clock Configuration (HSI 8 MHz)
  */
void SystemClock_Config(void)
{
  LL_FLASH_SetLatency(LL_FLASH_LATENCY_0);
  while(LL_FLASH_GetLatency() != LL_FLASH_LATENCY_0) {}

  LL_RCC_HSI_Enable();
  while(LL_RCC_HSI_IsReady() != 1) {}

  LL_RCC_HSI_SetCalibTrimming(16);
  LL_RCC_SetAHBPrescaler(LL_RCC_SYSCLK_DIV_1);
  LL_RCC_SetAPB1Prescaler(LL_RCC_APB1_DIV_1);
  LL_RCC_SetSysClkSource(LL_RCC_SYS_CLKSOURCE_HSI);
  while(LL_RCC_GetSysClkSource() != LL_RCC_SYS_CLKSOURCE_STATUS_HSI) {}

  LL_SetSystemCoreClock(8000000);
  if (HAL_InitTick(TICK_INT_PRIORITY) != HAL_OK) {
    Error_Handler();
  }
}

/**
  * @brief TIM16 Initialization|
  * Insert your calculated values
  */
static void MX_TIM16_Init(void)
{
  htim16.Instance = TIM16;
  htim16.Init.Prescaler =7999; // insert your psc value
  htim16.Init.CounterMode = TIM_COUNTERMODE_UP;
  htim16.Init.Period = 999;          // insert your calculated period or ARR
  htim16.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
  htim16.Init.RepetitionCounter = 0;
  htim16.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;
  if (HAL_TIM_Base_Init(&htim16) != HAL_OK) {
    Error_Handler();
  }

  NVIC_EnableIRQ(TIM16_IRQn);
}

/**
  * @brief GPIO Initialisation – PB0 as output (LED0)
  */
static void MX_GPIO_Init(void)
{
/*Insert PB0 initialisation code*/
	GPIO_InitTypeDef GPIO_InitStruct = {0}; //another structure to control GPIOB
	/*
	* typedef struct
	{
		uint32_t Pin;
		uint32_t Mode;
		uint32_t Pull;
		uint32_t Speed;
	} GPIO_InitTypeDef;
	 */
	// the "{0}" makes all attributes zero


	__HAL_RCC_GPIOB_CLK_ENABLE(); // Enable the clock to the GPIOB peripheral before accessing its registers.
	GPIO_InitStruct.Pin = GPIO_PIN_0; // telling it what to do with my structure variable
	GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
	GPIO_InitStruct.Pull = GPIO_NOPULL;
	GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;

	//the '&' before variables is for the address
	HAL_GPIO_Init(GPIOB, &GPIO_InitStruct);
}

/**
  * @brief TIM16 interrupt handler – toggles PB0 each time
  */
void TIM16_IRQHandler(void)
{
/*Toggle the pin*/
	// Once the timer16 reaches ARR, the hardware sets the Update Interrupt Flag
	// The interrupt stops the process and comes to this function which should toggle our pin
	//_FLAG just checks if an event occurs, for us we are checking that a timer event occurred
	// Basically checking if the Update Interrupt FLag is set
	if (__HAL_TIM_GET_FLAG(&htim16, TIM_FLAG_UPDATE) != RESET) {

		//Verify that the Update Interval Enable is set to one
		// _SOURCE macro checks the interrupt Enable Register
		if (__HAL_TIM_GET_IT_SOURCE(&htim16, TIM_IT_UPDATE) != RESET) {
			// clearing the UIF bit in the Status Register, so the NVIC does not reneter
			__HAL_TIM_CLEAR_IT(&htim16, TIM_IT_UPDATE);
			// this should toggle the led
			HAL_GPIO_TogglePin(GPIOB,GPIO_PIN_0);
		}
	}
}

/**
  * @brief Error handler
  */
void Error_Handler(void)
{
  __disable_irq();
  while (1) {}
}
