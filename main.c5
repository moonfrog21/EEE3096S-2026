#include "main.h"

/* ---------- Function prototypes ---------- */
static void GPIO_Init(void);
static void ADC_Init(void);
static void write_led_byte(uint8_t pattern);

int main(void)
{
    HAL_Init(); // still fine to call - only sets up SysTick/core clocks
    GPIO_Init();
    ADC_Init();

    /* TODO: Start continuous conversion using ADC1 control register */
    //ADC_CR_ADSTART is a macro for (1 << 2)
    // commands our board to start sampling
    ADC1->CR |= ADC_CR_ADSTART;

    while (1)
    {
        /* everything happens in the ISR */
    }
}

/* ---------- GPIO Configuration ---------- */
static void GPIO_Init(void)
{
    /* TODO: Enable clocks for GPIOA and GPIOB */
	// GPIO A and B  are part of the Advanced High performance bus, and we are using its ENable Register
	RCC->AHBENR |= RCC_AHBENR_GPIOAEN | RCC_AHBENR_GPIOBEN;

    /* TODO: Configure PA5 as Analogue mode (11) for ADC_IN5 */
	// Mode "11" is decimal 3, so we shift 10 places
	// We use 5*2 to make it clear that pin 5 is the target
	GPIOA->MODER |= (3U << (5*2));

    /* TODO: Configure PB0-PB7 as General purpose outputs (01) and clear ODR initially */
	// No HAL function so instead of a for loop we use hex values to handle the state of every LED
	GPIOB->MODER &= ~ (0xFFFFU); // clear the LEDs and the reset state
	GPIOB->MODER |= 0x5555U; //output all on 01 01 01 01 01 01 01 01 is 0x5555 in hex

	GPIOB->ODR &= ~(0xFFU);
}

/* ---------- ADC Configuration ---------- */
static void ADC_Init(void)
{
    /* TODO: Enable APB2 clock for ADC1 */
	RCC->APB2ENR |= RCC_APB2ENR_ADC1EN;

    /* TODO: Ensure ADC is disabled, then run calibration */
	if (ADC1->CR & ADC_CR_ADEN) {
		ADC1->CR |= ADC_CR_ADDIS; // AD Disable before calibrating
		while (ADC1->CR & ADC_CR_ADEN);
	}
	//calibration flag is set, the while loop is to wait for hardware to clear automatically
	ADC1->CR |= ADC_CR_ADCAL;
	while (ADC1->CR & ADC_CR_ADCAL);

    /* TODO: Select channel 5 (PA5) and configure sampling time */
	// We set bit 5 to channel selection register
	ADC1->CHSELR |= ADC_CHSELR_CHSEL5;

    /* TODO: Configure 12-bit resolution, right alignment, and continuous conversion mode */
	ADC1->CFGR1 |= ADC_CFGR1_CONT;

    /* TODO: Enable end-of-conversion interrupt and configure NVIC priorities */
	/*
	 * Enable the hardware to generate a signal on the NVIC line when a conversion finishes,
	 * allowing us to ditch polling and use the ADC1_COMP_IRQHandler.
	 */
	ADC1->IER |= ADC_IER_EOCIE;
	NVIC_SetPriority(ADC1_COMP_IRQn, 0);
	NVIC_EnableIRQ(ADC1_COMP_IRQn);

    /* TODO: Enable the ADC and wait for the ADRDY flag */
	ADC1->CR |= ADC_CR_ADEN;
	while (!(ADC1->ISR & ADC_ISR_ADRDY)); // while its not doing the service routine
}

/* ---------- Interrupt Service Routine ---------- */
void ADC1_COMP_IRQHandler(void)
{
	//this checks if the End of Conversion (EOC) flag is what caused this interrupt
    if (ADC1->ISR & ADC_ISR_EOC)
    {
        /* TODO: Read the raw 12-bit ADC value from the data register (DR) */
        uint32_t adc_val = ADC1->DR; // Replace with register read

        /* TODO: Scale the raw value proportionally to a number of LEDs (0 - 8) */
        uint8_t leds_to_light = (adc_val *9) / 4096; // Replace with your scaling calculation

        /* TODO: Build the bar-graph bit pattern using bitwise shifting */
        // we use the logic that if leds_to_lights = 3, then (1 << 3) yields binary 1000 (decimal 8)
        // 8 - 1 = 7, which is binary 0111
        // in that way we generate 3 ones
      //  uint8_t output_pattern = (1U << leds_to_light) - 1; // Replace with your bit pattern logic
        uint8_t output_pattern = ((1U << leds_to_light)-1) << (8 - leds_to_light); //reverse bit logic from left to right
        /* TODO: Drive PB0-PB7 using the helper function */
        write_led_byte(output_pattern);
    }
}

/* ---------- Helper: write an 8-bit pattern to PB0-PB7 ---------- */
static void write_led_byte(uint8_t pattern)
{
    uint32_t odr = GPIOB->ODR;
    odr &= ~(0xFFU);
    odr |= pattern;
    GPIOB->ODR = odr;
}
